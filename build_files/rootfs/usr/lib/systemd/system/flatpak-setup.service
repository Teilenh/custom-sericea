[Unit]
Description=First-boot Flatpak setup
After=network-online.target flatpak-system-helper.service
Wants=network-online.target
ConditionPathExists=!/var/lib/.flatpak-setup-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/flatpak-setup.sh
ExecStartPost=/usr/bin/touch /var/lib/.flatpak-setup-done

[Install]
WantedBy=multi-user.target
